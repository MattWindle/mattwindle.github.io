---
import SkillIcon from '../atoms/SkillIcon.astro';

const { name, svgMarkup } = Astro.props;
---

<li class="skill-tile">
  <SkillIcon svgMarkup={svgMarkup} />
  <span class="visually-hidden">{name}</span>
</li>

<style>
  .skill-tile {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px 24px;
    background: var(--color-white);
    border-radius: var(--radius-card);
    list-style: none;
  }
</style>