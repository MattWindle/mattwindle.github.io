---
import { SHAPE_VARIANTS } from '../../data/projects.js';

const { hashtag, number, shapeVariant = SHAPE_VARIANTS.CIRCLE } = Astro.props;
---

<div class="image-block">
  <div class={`image-block__shape image-block__shape--${shapeVariant}`} aria-hidden="true"></div>
  <span class="image-block__hashtag">{hashtag}</span>
  <span class="image-block__number">{number}</span>
</div>

<style>
  .image-block {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 272px;
    background: var(--color-navy);
    border-radius: var(--radius-card);
  }

  .image-block__hashtag {
    position: absolute;
    left: 20px;
    top: 16px;
    color: var(--color-white);
    font-size: 15px;
    font-weight: var(--font-weight-medium);
  }

  .image-block__number {
    position: absolute;
    left: 20px;
    bottom: 10px;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: var(--font-weight-bold);
    line-height: 1;
  }

  .image-block__shape {
    position: absolute;
    background: var(--color-orange);
  }

  .image-block__shape--circle {
    right: -40px;
    top: 70px;
    width: 190px;
    height: 190px;
    border-radius: var(--radius-round);
  }

  .image-block__shape--rounded-square {
    right: -30px;
    top: 60px;
    width: 180px;
    height: 180px;
    border-radius: 24px;
    transform: rotate(18deg);
  }

  .image-block__shape--ring {
    right: 20px;
    top: 80px;
    width: 110px;
    height: 110px;
    border: 16px solid var(--color-orange);
    border-radius: var(--radius-round);
    background: transparent;
  }

  .image-block__shape--triangle {
    right: -20px;
    top: 90px;
    width: 0;
    height: 0;
    border-left: 90px solid transparent;
    border-right: 90px solid transparent;
    border-bottom: 150px solid var(--color-orange);
    background: transparent;
  }
</style>