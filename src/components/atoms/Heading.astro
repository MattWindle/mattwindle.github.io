---
const HEADING_TONES = {
  ON_LIGHT: 'on-light',
  ON_DARK: 'on-dark',
};

const { level = 2, tone = HEADING_TONES.ON_LIGHT } = Astro.props;

// Lets us render an h1, h2 or h3 from the same component.
const HeadingElement = `h${level}`;
---

<HeadingElement class={`heading heading--level-${level} heading--${tone}`}>
  <slot />
</HeadingElement>

<style>
  .heading {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
  }

  .heading--on-light {
    color: var(--color-navy);
  }

  .heading--on-dark {
    color: var(--color-white);
  }

  .heading--level-1 {
    font-size: var(--font-size-h1);
    line-height: 1.04;
  }

  .heading--level-2 {
    font-size: var(--font-size-h2);
    line-height: 1.2;
  }

  .heading--level-3 {
    font-size: var(--font-size-h3);
    line-height: 1.2;
  }

  /* The orange highlighter. Wrap words in <span class="heading-highlight"> inside the slot. */
  .heading :global(.heading-highlight) {
    background: linear-gradient(
      transparent 62%,
      var(--color-orange) 62%,
      var(--color-orange) 92%,
      transparent 92%
    );
  }

  @media (max-width: 820px) {
    .heading--level-1 {
      font-size: var(--font-size-h1-mobile);
    }
  }
</style>