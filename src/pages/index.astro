---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavList from '../components/molecules/NavList.astro';
import SectionHeader from '../components/molecules/SectionHeader.astro';
import SkillTile from '../components/molecules/SkillTile.astro';
import DotGridPanel from '../components/molecules/DotGridPanel.astro';
import ProjectCard from '../components/molecules/ProjectCard.astro';
import { SKILLS } from '../data/skills.js';
import { PROJECTS } from '../data/projects.js';
import { banner, skillsSection, projectsSection } from '../data/site.js';

// Throwaway values: the ProjectStack organism will own these later.
const BASE_STICKY_OFFSET_PX = 24;
const STICKY_STEP_PX = 25;
---

<BaseLayout>
  <main id="main-content" class="container" style="display:grid;gap:48px;padding-block:48px">
    <NavList />

    <div style="display:flex;min-height:460px">
      <DotGridPanel badgeText={banner.badgeText} placeholderText={banner.photoPlaceholderText} />
    </div>

    <div style="background:#14213D;padding:32px">
      <SectionHeader
        label={skillsSection.label}
        heading={skillsSection.heading}
        intro={skillsSection.intro}
        tone="on-dark"
      />
      <ul style="display:flex;gap:16px;margin:24px 0 0;padding:0">
        {SKILLS.map(({ name, svgMarkup }) => <SkillTile name={name} svgMarkup={svgMarkup} />)}
      </ul>
    </div>

    <div>
      <SectionHeader
        label={projectsSection.label}
        heading={projectsSection.heading}
        intro={projectsSection.intro}
      />
      <div style="margin-top:32px">
        {PROJECTS.map((project, index) => (
          <ProjectCard
            project={project}
            index={index}
            stickyTopPx={BASE_STICKY_OFFSET_PX + index * STICKY_STEP_PX}
          />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>